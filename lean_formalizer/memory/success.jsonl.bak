{"id": "ce00459b-ce1e-474e-94f6-b68bd62fabe2", "natural_language": "Addition of natural numbers is commutative: m + n = n + m.", "lean_code": "theorem nat_add_comm (m n : ℕ) : m + n = n + m := Nat.add_comm m n", "domain": "number_theory", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["nat", "comm"], "created_at": "2026-07-27T10:51:18.851745+00:00", "metadata": {}}
{"id": "9e7b68a1-2830-45de-ae55-8f39542eee75", "natural_language": "Addition of natural numbers is associative: (a + b) + c = a + (b + c).", "lean_code": "theorem nat_add_assoc (a b c : ℕ) : (a + b) + c = a + (b + c) := Nat.add_assoc a b c", "domain": "number_theory", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["nat", "assoc"], "created_at": "2026-07-27T10:51:19.091938+00:00", "metadata": {}}
{"id": "ec77f1ff-4dcb-40d7-ad54-53cb3cd9dde3", "natural_language": "Multiplication of natural numbers distributes over addition: a * (b + c) = a * b + a * c.", "lean_code": "theorem nat_mul_add (a b c : ℕ) : a * (b + c) = a * b + a * c := Nat.mul_add a b c", "domain": "number_theory", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["nat", "distrib"], "created_at": "2026-07-27T10:51:19.331453+00:00", "metadata": {}}
{"id": "05ec8083-e5bd-4198-8dcd-1c3a564089aa", "natural_language": "For any natural number n, n + 0 = n.", "lean_code": "theorem nat_add_zero (n : ℕ) : n + 0 = n := Nat.add_zero n", "domain": "number_theory", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["nat"], "created_at": "2026-07-27T10:51:19.566706+00:00", "metadata": {}}
{"id": "58b98ead-ac53-42e9-ae69-909daad70f56", "natural_language": "If a ≤ b and b ≤ c then a ≤ c (transitivity of ≤ on natural numbers).", "lean_code": "theorem nat_le_trans {a b c : ℕ} (h₁ : a ≤ b) (h₂ : b ≤ c) : a ≤ c :=\n  Nat.le_trans h₁ h₂", "domain": "number_theory", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["nat", "order"], "created_at": "2026-07-27T10:51:19.793236+00:00", "metadata": {}}
{"id": "b46861a8-5421-44c3-8f00-77aecffa2b07", "natural_language": "The successor of a natural number is never zero: ¬(n + 1 = 0).", "lean_code": "theorem nat_succ_ne_zero (n : ℕ) : n + 1 ≠ 0 := Nat.succ_ne_zero n", "domain": "number_theory", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["nat"], "created_at": "2026-07-27T10:51:20.038891+00:00", "metadata": {}}
{"id": "dad1a69d-5586-4278-ad4a-0377cbff4234", "natural_language": "Logic: and is commutative — P ∧ Q implies Q ∧ P.", "lean_code": "theorem and_comm_prop {P Q : Prop} (h : P ∧ Q) : Q ∧ P := And.symm h", "domain": "logic", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["logic", "and"], "created_at": "2026-07-27T10:51:20.277781+00:00", "metadata": {}}
{"id": "a474dd04-812c-433e-9b84-41adcbd1dea3", "natural_language": "Logic: modus ponens — from P and P → Q conclude Q.", "lean_code": "theorem modus_ponens {P Q : Prop} (hP : P) (h : P → Q) : Q := h hP", "domain": "logic", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["logic"], "created_at": "2026-07-27T10:51:20.503915+00:00", "metadata": {}}
{"id": "050e585a-8ef3-443e-80d7-8032c2c00045", "natural_language": "Logic: if P then P ∨ Q.", "lean_code": "theorem or_intro_left {P Q : Prop} (h : P) : P ∨ Q := Or.inl h", "domain": "logic", "difficulty": "easy", "success": true, "wrong_code": "", "error_message": "", "corrected_code": "", "tags": ["logic", "or"], "created_at": "2026-07-27T10:51:20.734806+00:00", "metadata": {}}
