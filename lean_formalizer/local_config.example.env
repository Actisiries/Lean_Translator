# Copy this file to local_config.env and edit once.
# Used when starting via: python run_web.py (load yourself or use setup_autoconfig.py)

# Folder containing lean-toolchain / lakefile (any Mathlib Lake project root).
# Detected automatically on first-time setup; override if needed.
# LEAN_PROJECT=/path/to/your/mathlib_project

# Optional: path to lean binary if not on PATH
# LEAN_PATH=lean

# Memory directory (defaults to ./memory next to this repo)
# MEMORY_DIR=

# Offline demo (no API calls)
LLM_BACKEND=mock

# --- Real LLM (OpenAI-compatible, including CC Switch) ---
# LLM_BACKEND=openai
# OPENAI_BASE_URL=http://127.0.0.1:PORT/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=deepseek-v4-flash

# --- Anthropic ---
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Timeouts (seconds)
# LLM_TIMEOUT=300
# JOB_TIMEOUT=1200
# LEAN_TIMEOUT=300
# (first Mathlib typecheck can be slow; raise if you see "compilation timed out")
